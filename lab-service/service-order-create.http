### 创建服务单 - 上门维修
POST http://localhost:8082/internal/shops/1/aftersales/123/serviceorders
Content-Type: application/json
# authorization: Bearer your-token-here   # 如果不需要认证，注释掉这行

{
  "type": 0,
  "consignee": {
    "name": "张三",
    "mobile": "13800138000",
    "regionId": 110101,
    "address": "北京市朝阳区望京SOHO T3 20层"
  }
}

> {%
    client.test("创建服务单成功", function() {
        client.assert(response.status === 200, "预期状态码 200，但实际是 " + response.status);
        client.assert(response.contentType.json.errno === 0, "errno 应为 0，实际为 " + response.contentType.json.errno);
    });
%}

