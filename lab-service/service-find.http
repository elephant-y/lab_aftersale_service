### 按商户ID查询服务单（正常场景）
GET http://119.3.163.139:8080/internal/shops/1/serviceorders/45

> {%
    client.test("查询服务单成功", function() {
        client.assert(response.status === 200, "状态码错误");
        var json = JSON.parse(response.body);
        client.assert(json.errno === 0, "errno错误");
        client.assert(typeof json.data === 'object' && json.data.id, "返回应为服务单对象");
    });
%}

### 测试服务单不存在场景
GET http://119.3.163.139:8080/internal/shops/2/serviceorders/9999

> {%
    client.test("服务单不存在返回错误", function() {
        client.assert(response.status === 200, "状态码错误");
        var json = JSON.parse(response.body);
        client.assert(json.errno === 504, "errno应为504（资源不存在）");
    });
%}

